@if (TempData["ErrosModal"] != null)
{
    <div class="modal fade" id="modalErros" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Erro(s) encontrado(s):</h5>
                </div>

                <div class="modal-body">
                    @Html.Raw(TempData["ErrosModal"])
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Ok </button>
                </div>

            </div>
        </div>
    </div>
    <script>
        var modal = new bootstrap.Modal(document.getElementById('modalErros'));
        modal.show();
    </script>
}


