@model CadastroDeUsuariosViewModel

@{
    ViewData["Title"] = "Cadastro de Usuários";
}

<h2>Cadastro de Usuários</h2>

<form method="post">
    <div class="mb-2">
        <label>Nome:</label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Sobrenome:</label>
        <input asp-for="Sobrenome" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Email:</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-2">
        <label>CPF:</label>
        <input asp-for="Cpf" class="form-control" />
    </div>

    <div class="mt-3">
        <button type="submit" asp-action="Cadastrar" class="btn btn-primary">Cadastrar</button>
        <button type="submit" asp-action="Deletar" class="btn btn-danger">Deletar</button>
    </div>
</form>

<hr />

<h4>Usuários Cadastrados</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Sobrenome</th>
            <th>Email</th>
            <th>CPF</th>
            <th>Perfil</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Lista)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Nome</td>
                <td>@u.Sobrenome</td>
                <td>@u.Email.email</td>
                <td>@u.Cpf.cpf</td>
                <td>@u.Perfil.TipoPerfil</td>
            </tr>
        }
    </tbody>
</table>
